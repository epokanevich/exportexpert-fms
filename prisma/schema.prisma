// FMS «Экспортэксперт» — схема данных.
// Боевая БД — PostgreSQL (Neon). Для полностью локального запуска можно вернуть provider = "sqlite"
// и DATABASE_URL="file:./dev.db" — схема совместима с обоими провайдерами.
// Перечисления хранятся строками; допустимые значения и подписи — src/lib/domain/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  role              String    @default("INSPECTOR") // ADMIN | MANAGER | INSPECTOR; по умолчанию — наименее привилегированная (D-30)
  passwordHash      String
  /// Версия сессий (D-10): входит в JWT; инкремент при выходе, смене роли и пароля отзывает все выданные токены.
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  auditLogs AuditLog[]
}

/// Ограничитель перебора паролей (D-09): общий для всех инстансов, ключ — «ip|email» или «ip».
model LoginAttempt {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Аудит-журнал (3.7): кто и когда выполнил мутацию. Пишется в той же транзакции, что и сама операция.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName  String
  action     String // CONTAINER_CREATE, ONE_WAY_ISSUE, LEASE_OFF_HIRE, USER_ROLE_CHANGE …
  entityType String // Container | OneWayTrip | LeaseContract | User | ContainerEvent | System
  entityId   String?
  summary    String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model Container {
  id String @id @default(cuid())

  // 1. Паспорт и идентификация
  bicCode          String @unique // ISO 6346 без разделителей: EXEX4029183
  sizeType         String // 20DC | 20HQ | 40DC | 40HC | 40HR | 20OT | 40FR
  isoCode          String // 22G1, 45G1, 45R1 …
  manufactureYear  Int
  colorRal         String
  manufacturer     String
  tareWeightKg     Int
  maxPayloadKg     Int
  maxGrossWeightKg Int

  // 2. Техническое состояние и комплаенс
  conditionGrade String // IICL6 | CW | WWT | DAMAGED
  techStatus     String // SOUND | DAMAGED | IN_REPAIR | HOLD
  cscPlateExpiry DateTime // КБК / дата следующего освидетельствования (ACEP / PES)
  cscPlateNumber String? // номер таблички CSC (Safety Approval), например RS/CSC/1234/2021
  acepNumber     String? // номер одобрения программы ACEP / PES собственника
  eorAmountUsd   Decimal? @db.Decimal(12, 2) // Estimate of Repair

  // 3. Дислокация и операционный статус
  operationalStatus    String // AVAILABLE | ONE_WAY | LONG_TERM_LEASE | IN_TRANSIT | MAINTENANCE
  currentLocode        String
  currentTerminal      String
  storageStartDate     DateTime?
  storageRatePerDayUsd Decimal?  @db.Decimal(12, 2)

  // Собственник единицы: свой парк, взят в лизинг (leased-in) или в управлении (managed)
  ownershipType String  @default("OWNED") // OWNED | LEASED_IN | MANAGED
  ownerName     String  @default("ООО «Экспортэксперт»")
  lessorName    String? // лизингодатель / собственник для LEASED_IN и MANAGED

  // 4. Финансы и экономика единицы
  purchaseDate        DateTime
  purchasePriceUsd    Decimal  @db.Decimal(12, 2)
  currentBookValueUsd Decimal  @db.Decimal(12, 2)
  totalRevenueUsd     Decimal  @default(0) @db.Decimal(12, 2)
  totalRepairCostUsd  Decimal  @default(0) @db.Decimal(12, 2)

  notes     String?
  /// Мягкое удаление (списание): история и договоры сохраняются, в реестре единица скрыта (фильтр «Списанные»).
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events      ContainerEvent[]
  oneWayTrips OneWayTrip[]
  leaseItems  LeaseItem[]
  damages     DamageItem[]
  attachments Attachment[]

  @@index([operationalStatus])
  @@index([currentLocode])
  @@index([deletedAt])
}

// 5. История операций (Audit & Movement Log)
model ContainerEvent {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Restrict)
  type        String // GATE_IN | GATE_OUT | ONE_WAY_OUT | ONE_WAY_IN | LEASE_ON_HIRE | LEASE_OFF_HIRE | INSPECTION | REPAIR_START | REPAIR_DONE | STATUS_CHANGE | PURCHASE | CSC_RENEWAL | LEASE_EXTENDED
  occurredAt  DateTime
  locode      String?
  terminal    String?
  description String
  amountUsd   Decimal?  @db.Decimal(12, 2)
  actor       String?
  createdAt   DateTime  @default(now())

  damages     DamageItem[]
  attachments Attachment[]

  @@index([containerId, occurredAt])
}

/// Строка акта осмотра: повреждение в кодах CEDEX (ISO 9897) / IICL. Сумма строк — EOR акта.
model DamageItem {
  id           String         @id @default(cuid())
  containerId  String
  container    Container      @relation(fields: [containerId], references: [id], onDelete: Restrict)
  eventId      String
  event        ContainerEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  locationCode String // CEDEX location, 4 символа: например LX2N
  component    String // узел: «боковая панель», «пол», «дверь» (код компонента CEDEX — по справочнику)
  damageCode   String // CEDEX damage: DT, HO, CK …
  repairCode   String? // CEDEX repair: RP, PA, SN …
  lengthCm     Int?
  widthCm      Int?
  quantity     Int            @default(1)
  costUsd      Decimal?       @db.Decimal(12, 2)
  status       String         @default("OPEN") // OPEN | REPAIRED
  repairedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([containerId, status])
  @@index([eventId])
}

/// Вложение к событию журнала (фото EIR, акт осмотра). Файл — в хранилище (storageKey), не в public.
model Attachment {
  id           String         @id @default(cuid())
  containerId  String
  container    Container      @relation(fields: [containerId], references: [id], onDelete: Restrict)
  eventId      String
  event        ContainerEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  fileName     String
  mimeType     String // image/png | image/jpeg | application/pdf — определён по сигнатуре файла
  sizeBytes    Int
  sha256       String
  storageKey   String         @unique
  uploadedById String?
  createdAt    DateTime       @default(now())

  @@index([eventId])
  @@index([containerId])
}

/// Содержимое вложения для драйвера хранилища «db» (прод без S3: Render/Neon). Отдельная таблица — списки не тянут байты.
model AttachmentBlob {
  storageKey String   @id
  data       Bytes
  createdAt  DateTime @default(now())
}

model OneWayTrip {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Restrict)

  counterpartyName    String
  counterpartyInn     String?
  counterpartyContact String?
  bookingRef          String

  pickupLocode    String
  pickupTerminal  String
  dropoffLocode   String
  dropoffTerminal String

  handoverDate     DateTime // Gate-Out
  freeDays         Int
  deadlineDate     DateTime // handoverDate + freeDays
  actualReturnDate DateTime? // Gate-In

  feeUsd                 Decimal @default(0) @db.Decimal(12, 2)
  detentionRatePerDayUsd Decimal @db.Decimal(12, 2)

  status          String // ACTIVE | COMPLETED | DISPUTE  (OVERDUE вычисляется: ACTIVE и дедлайн прошёл)
  returnCondition String? // SOUND | DAMAGED
  returnEorUsd    Decimal? @db.Decimal(12, 2)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([containerId]) // FK: профиль контейнера и реестр выбирают рейсы по контейнеру (Supabase advisor: unindexed_foreign_keys)
}

model LeaseContract {
  id                   String   @id @default(cuid())
  contractNumber       String   @unique
  lesseeName           String
  lesseeInn            String?
  contactPerson        String
  contactPhone         String?
  contactEmail         String?
  startDate            DateTime // On-Hire
  endDate              DateTime // плановый Off-Hire
  autoRenewal          Boolean  @default(false)
  dailyRateUsd         Decimal  @db.Decimal(12, 2) // Per Diem за единицу — действующая ставка (история — LeaseRatePeriod)
  currency             String   @default("USD")
  depositUsd           Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus        String // PAID | PENDING | OVERDUE (текущий месяц)
  allowedReturnLocodes String // CSV: "RUVVO,RUNVR"
  onHireSurvey         String   @default("SIGNED") // PENDING | SIGNED
  offHireSurvey        String   @default("NOT_STARTED") // NOT_STARTED | PENDING | SIGNED
  status               String   @default("ACTIVE") // ACTIVE | COMPLETED
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items       LeaseItem[]
  ratePeriods LeaseRatePeriod[]
}

model LeaseItem {
  id           String        @id @default(cuid())
  leaseId      String
  lease        LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  containerId  String
  container    Container     @relation(fields: [containerId], references: [id], onDelete: Restrict)
  onHireDate   DateTime
  offHireDate  DateTime?
  returnLocode String?

  @@index([leaseId])
  @@index([containerId])
}

/// История ставок Per Diem (D-08): ставка действует с effectiveFrom до начала следующего периода.
/// Уже начисленные дни не пересчитываются: новый период нельзя начать раньше «сегодня».
model LeaseRatePeriod {
  id            String        @id @default(cuid())
  leaseId       String
  lease         LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime
  dailyRateUsd  Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  @@unique([leaseId, effectiveFrom])
}
