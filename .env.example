# ── Обязательные ───────────────────────────────────────────────────────────
# PostgreSQL 14+ (Neon / Supabase / RDS / локальный). Для Neon — pooled-хост (…-pooler…) и sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Секрет подписи JWT-сессий (не менее 32 символов). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-random-secret-at-least-32-chars"

# ── Режим работы ───────────────────────────────────────────────────────────
# Демо-режим ВЫКЛЮЧЕН по умолчанию. Включайте только на демо-стенде: вход в 1 клик с паролем
# на странице входа, гид проверяющего, «Сбросить демо-данные» (стирает базу!).
# DEMO_MODE="true"

# Первый запуск боевого стенда (пустая база, DEMO_MODE выключен): создаётся только администратор.
# Без пароля сборка остановится с понятной ошибкой. Пароль — не короче 10 символов; смените его после входа.
ADMIN_INITIAL_PASSWORD=""
# ADMIN_EMAIL="admin@exportexpert.ru"
# ADMIN_NAME="Администратор"

# ── Время и сеть ───────────────────────────────────────────────────────────
# Часовой пояс компании (IANA): «сегодня» для просрочек, начислений и даты дашборда. По умолчанию Europe/Moscow.
# BUSINESS_TIMEZONE="Europe/Moscow"

# Сколько доверенных прокси стоит перед приложением (лимит входа берёт IP клиента из X-Forwarded-For).
# Render / Vercel — 1. Если поставите ещё CDN/обратный прокси, увеличьте; иначе клиент сможет подменять свой IP.
# TRUSTED_PROXY_HOPS="1"

# ── Вложения (фото EIR, акты) ──────────────────────────────────────────────
# db    — файлы в PostgreSQL (таблица AttachmentBlob): переживают передеплой, бэкапятся с базой. По умолчанию в production.
# local — каталог на диске вне public (ATTACHMENTS_DIR). По умолчанию в разработке. На Render диск эфемерный!
# ATTACHMENTS_DRIVER="db"
# ATTACHMENTS_DIR=".data/attachments"
