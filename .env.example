# PostgreSQL (Neon / Vercel Postgres / любой Postgres 14+). Строку берите в консоли Neon → Connect.
# Для Neon используйте pooled-хост (…-pooler…) и обязательно sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Секрет подписи JWT-сессий (не менее 32 символов). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-random-secret-at-least-32-chars"
